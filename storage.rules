
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow read access to everyone for all files.
    // This is safe because file names are unique UUIDs and not guessable.
    match /{allPaths=**} {
      allow read;
    }

    // Allow write access only to the team-images folder for authenticated users.
    // This secures the storage so only logged-in admins can upload team photos.
    match /team-images/{imageId} {
      allow write: if request.auth != null;
    }
  }
}
